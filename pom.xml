<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.optionfactory.spring</groupId>
        <artifactId>optionfactory-spring-dependencies</artifactId>
        <version>29.2</version>
        <relativePath>optionfactory-spring-dependencies/pom.xml</relativePath>
    </parent>
    <artifactId>optionfactory-spring</artifactId>
    <version>29.2</version>
    <packaging>pom</packaging>
    <description>optionfactory-spring parent pom</description>
    <name>${project.groupId}:${project.artifactId}</name>
    <modules>
        <module>marshaling-jaxb</module>
        <module>marshaling-jackson</module>
        <module>data-jpa-test</module>
        <module>data-jpa</module>
        <module>data-jpa-web</module>
        <module>context</module>
        <module>context-web</module>
        <module>problems</module>
        <module>problems-web</module>
        <module>client-reports</module>
        <module>content-security-policies</module>
        <module>authentication</module>
        <module>authentication-tokens</module>
        <module>authentication-authorization-code</module>
        <module>authentication-resource-server</module>
        <module>email</module>
        <module>upstream</module>
        <module>upstream-interceptor-jws</module>
        <module>upstream-interceptor-spring-oauth2</module>
        <module>upstream-alerts-email</module>
        <module>validators</module>
        <module>thymeleaf</module>
        <module>localized-enums</module>
        <module>pem</module>
        <module>pdf</module>
        <module>applications-web-tomcat</module>
        <module>downstream</module>
        <module>downstream-maven-plugin</module>
        <module>optionfactory-spring-bom</module>
        <module>optionfactory-spring-dependencies</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <maven.compiler.showWarnings>true</maven.compiler.showWarnings>
        <maven.compiler.showDeprecation>true</maven.compiler.showDeprecation>
        <maven.compiler.proc>none</maven.compiler.proc>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>6.1.3</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest</artifactId>
                <version>3.0</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.jayway.jsonpath</groupId>
                <artifactId>json-path</artifactId>
                <version>3.0.0</version>
            </dependency>            
        </dependencies>        
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:unchecked</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>                    
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
