options {
    STATIC = false;
    UNICODE_INPUT = true;
}

PARSER_BEGIN(PemParser)
package net.optionfactory.spring.pem.parsing;
import java.io.IOException;
import java.io.InputStream;
import java.io.InputStreamReader;
import java.io.Reader;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.List;
import net.optionfactory.spring.pem.PemException;

/// The JavaCC generated parser of PEM streams.
///
/// A stream is a sequence of entries separated by spaces and line breaks, each optionally preceded by
/// `key: value` or `key = value` metadata lines. Labels are the printable ASCII characters but
/// `-`, plus spaces and tabs, as RFC 7468 defines them; the label of the `-----END` line is not
/// checked against the one of the `-----BEGIN` line. Within an entry, whitespace between the base64
/// characters is ignored. Any other text is a parse failure.
///
/// The JavaCC token manager takes any exception raised while reading for the end of the input. The
/// stream is therefore read through a [RecordingReader], which ends the input on the first
/// `IOException` and keeps it, so that [#parse(InputStream)] reports it instead of returning the
/// entries read until then.
public class PemParser {

    /// Parses a UTF-8 PEM stream, without decoding the entries. The stream is closed when read to
    /// its end, and left open on a parse failure.
    ///
    /// @param is the stream
    /// @return the entries, in file order, empty for an empty or blank stream
    /// @throws PemException when the stream is not well-formed PEM, or when reading it fails, the
    /// `IOException` being the cause
    public static List<PemEntry> parse(InputStream is) {
        final var r = new RecordingReader(new InputStreamReader(is, StandardCharsets.UTF_8));
        try{
            final var p = new PemParser(r);
            final var entries = p.entries();
            r.ensureNoFailure();
            return entries;
        }catch(ParseException ex){
            r.ensureNoFailure();
            throw new PemException(ex);
        }
    }

    /// A [Reader] ending the input on the first `IOException` of the wrapped one, and keeping it.
    /// Once the input has ended, the wrapped reader is no longer read.
    private static class RecordingReader extends Reader {

        private final Reader inner;
        private boolean ended;
        private IOException failure;

        private RecordingReader(Reader inner) {
            this.inner = inner;
        }

        @Override
        public int read(char[] buffer, int offset, int length) {
            if (ended) {
                return -1;
            }
            try {
                final var got = inner.read(buffer, offset, length);
                ended = got == -1;
                return got;
            } catch (IOException ex) {
                ended = true;
                failure = ex;
                return -1;
            }
        }

        @Override
        public void close() throws IOException {
            ended = true;
            inner.close();
        }

        private void ensureNoFailure() {
            if (failure != null) {
                throw new PemException(failure);
            }
        }
    }

}
PARSER_END(PemParser)



<DEFAULT> TOKEN: {
      <BEGIN_PREFIX: "-----BEGIN ">: IN_BEGIN_LABEL
    | <SPACES: (["\r", "\n", " "])+ >
    | <METADATA_KEY: ["a"-"z","A"-"Z"](["a"-"z","A"-"Z","0"-"9","."])+ >
    | <METADATA_SEPARATOR: [":","="] >: METADATA

}

<METADATA> TOKEN : {
    <METADATA_VALUE: (~["\r","\n"])+> : DEFAULT
}

<IN_BEGIN_LABEL> TOKEN: {
      <BEGIN_SUFFIX:       "-----">: IN_BASE64
    | <BEGIN_LABEL: (["\u0021"-"\u002c","\u002e"-"\u007e", " ", "\t"])+ > 

}

<IN_BASE64> TOKEN: {
      <BASE64_FRAGMENT: (["A"-"Z","a"-"z","0"-"9","+","/","="])+ >
    | <END_PREFIX:   "-----END "  >: IN_END_LABEL

}

<IN_END_LABEL> TOKEN: {
      <END_SUFFIX:       "-----">: DEFAULT
    | <END_LABEL: (["\u0021"-"\u002c","\u002e"-"\u007e", " ", "\t"])+ >

}

<IN_BASE64> SKIP: {
    "\t"|" "|"\r"|"\n"
}

 <*> TOKEN : { 
    <UNKNOWN: ~[]> 
}

private List<PemEntry> entries():
{
    List<PemEntry> results = new ArrayList<PemEntry>(); PemEntry e;
}
{
    (<SPACES>)?
    (e=entry() (<SPACES>)? { results.add(e); })*
    <EOF>
    { return results; }
}


private PemEntry entry():
{
    Token mk=null;
    Token mv=null;
    Token bl=null;
    Token b64=null;
    List<PemEntry.Metadata> metadata = new ArrayList<PemEntry.Metadata>();
    StringBuilder b64s = new StringBuilder();
}
{
    (mk=<METADATA_KEY> (<SPACES>)? <METADATA_SEPARATOR> mv=<METADATA_VALUE> <SPACES> {metadata.add(new PemEntry.Metadata(mk.image.toLowerCase(), mv.image.trim())); })*
    <BEGIN_PREFIX> (bl=<BEGIN_LABEL>)? <BEGIN_SUFFIX>
    (b64=<BASE64_FRAGMENT> { b64s.append(b64.image); })+
    <END_PREFIX> (<END_LABEL>)? <END_SUFFIX>
    { return new PemEntry(bl != null ? bl.image : null, metadata, b64s.toString()); }
}

